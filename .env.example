# Telegram Bot API token from @BotFather
BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# Secret path segment for the webhook URL, e.g. https://your-domain/webhook/<WEBHOOK_SECRET>
# Use a long random string. Generate one with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
WEBHOOK_SECRET=change-me-to-a-long-random-string

# Public HTTPS base URL where Telegram can reach you (tunnel URL in dev, Railway/Fly URL in prod)
# No trailing slash. Example: https://abcd1234.trycloudflare.com or https://your-app.up.railway.app
PUBLIC_URL=https://example.com

# Upstash Redis REST credentials (from the Upstash console, "REST API" section of your database)
UPSTASH_REDIS_REST_URL=https://example.upstash.io
UPSTASH_REDIS_REST_TOKEN=example-token

# Port the HTTP server listens on (Railway/Fly set this automatically; 3000 is fine for local/tunnel dev)
PORT=3000
